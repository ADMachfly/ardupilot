# SR-75 Layer 2J-B3 software-only closed-loop SITL JSON parameters.
# These settings are for localhost simulation only; they do not enable hardware output.

LOG_DISARMED 1
LOG_BITMASK 65535

# Start directly in FBWA for attitude stabilization. Mode number 5 is
# ArduPlane FLY_BY_WIRE_A.
INITIAL_MODE 5
FLTMODE_CH 0

# SR-75 elevon/rudder/throttle outputs into the SIM_JSON PWM packet.
SERVO1_FUNCTION 77
SERVO2_FUNCTION 78
SERVO3_FUNCTION 70
SERVO4_FUNCTION 21
SERVO7_FUNCTION 0

SERVO1_REVERSED 1
SERVO2_REVERSED 1
SERVO3_REVERSED 0
SERVO4_REVERSED 1

SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO1_TRIM 1500
SERVO2_MIN 1000
SERVO2_MAX 2000
SERVO2_TRIM 1500
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO3_TRIM 1000
SERVO4_MIN 1000
SERVO4_MAX 2000
SERVO4_TRIM 1500
SERVO7_MIN 1000
SERVO7_MAX 2000
SERVO7_TRIM 1000

RC1_MIN 1000
RC1_MAX 2000
RC1_TRIM 1500
RC2_MIN 1000
RC2_MAX 2000
RC2_TRIM 1500
RC3_MIN 1000
RC3_MAX 2000
RC3_TRIM 1000
RC4_MIN 1000
RC4_MAX 2000
RC4_TRIM 1500
RC7_MIN 1000
RC7_MAX 2000
RC7_TRIM 1000

# Use the SIM_JSON synthetic airspeed backend.
ARSPD_TYPE 100
ARSPD_USE 1
AIRSPEED_MIN 40
AIRSPEED_MAX 125
AIRSPEED_CRUISE 69
ARSPD_FBW_MIN 40
ARSPD_FBW_MAX 125
TRIM_ARSPD_CM 6900

THR_MIN 0
THR_MAX 100
THR_CRUISE 55
THR_SLEWRATE 100

PTCH_LIM_MAX_DEG 30
PTCH_LIM_MIN_DEG -20
LIM_ROLL_CD 4500
SCALING_SPEED 69

TECS_CLMB_MAX 20
TECS_SINK_MIN 6
TECS_SINK_MAX 25
TECS_TIME_CONST 5.0
TECS_THR_DAMP 0.8
TECS_PTCH_DAMP 0.5
TECS_SPDWEIGHT 1.0

RLL2SRV_RMAX 90
RLL2SRV_TCONST 0.25
RLL_RATE_D 0.017430
RLL_RATE_FF 0.237212
RLL_RATE_I 0.25
RLL_RATE_P 0.3
PTCH2SRV_RMAX_DN 90
PTCH2SRV_RMAX_UP 90
PTCH2SRV_TCONST 0.25
PTCH_RATE_D 0.007265
PTCH_RATE_FF 0.595723
PTCH_RATE_I 0.11
PTCH_RATE_P 0.15
PTCH2SRV_RLL 1

# Keep RATO available only as decoded/logged software channel; the fixed RC7
# input from the responder keeps it off for B3.
RATO_ENABLE 1
RATO_IGN_CH 7
RATO_EJ_CH 8

FS_SHORT_ACTN 0
FS_LONG_ACTN 0
