# SR-75 Layer 2 HIL Bench Parameters
# Bench-safe first version

LOG_DISARMED 1
LOG_BITMASK 65535

# Airspeed / TECS
AIRSPEED_MIN 40
AIRSPEED_MAX 125
AIRSPEED_CRUISE 69
TRIM_ARSPD_CM 6900

THR_MIN 0
THR_MAX 100
THR_CRUISE 55
THR_SLEWRATE 30

PTCH_LIM_MAX_DEG 30
PTCH_LIM_MIN_DEG -20
LIM_ROLL_CD 4500
SCALING_SPEED 69

TECS_CLMB_MAX 20
TECS_SINK_MIN 6
TECS_SINK_MAX 25
TECS_TIME_CONST 5.0
TECS_THR_DAMP 0.8
TECS_PTCH_DAMP 0.5
TECS_SPDWEIGHT 1.0

# RATO enabled for software validation, but outputs must remain dummy
RATO_ENABLE 1
RATO_IGN_CH 7
RATO_EJ_CH 8

# Safety: keep failsafe actions bench-safe for initial tests
FS_SHORT_ACTN 0
FS_LONG_ACTN 0
