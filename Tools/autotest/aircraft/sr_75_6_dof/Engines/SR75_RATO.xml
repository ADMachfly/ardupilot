<?xml version="1.0"?>
<rocket_engine name="SR75_RATO_5p8kN">

  <!-- RATO placeholder for initial launch dynamics only.
       Modeled as a command-gated rocket so it has fixed thrust, no turbine
       spool delay, and zero propellant flow whenever throttle-cmd-norm[2] is
       zero. The 9.18 kg tank is depleted by the commanded burn; the 10 kg dry
       booster is retained until the separate staging command removes it. -->

  <!-- 5800 N = 1303.891 lbf. 3.06 kg/s = 6.746 lb/s, so Isp is 193.28 s. -->
  <isp>193.28</isp>
  <propflowmax unit="KG/SEC">3.06</propflowmax>
  <maxthrottle>1.0</maxthrottle>
  <minthrottle>0.0</minthrottle>

</rocket_engine>
