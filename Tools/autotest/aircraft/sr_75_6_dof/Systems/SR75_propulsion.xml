<?xml version="1.0"?>
<propulsion name="SR75 propulsion">

  <!-- Main UAV fuel. Fuel mass appears only as JSBSim tank contents. -->
  <tank type="FUEL" name="main_jet_fuel">
    <location unit="M">
      <x>-0.10</x>
      <y>0.0</y>
      <z>-0.02</z>
    </location>
    <capacity unit="KG">30.0</capacity>
    <contents unit="KG">20.0</contents>
    <type>JET-A</type>
    <priority>1</priority>
  </tank>

  <!-- RATO propellant placeholder. Do not duplicate this mass as a pointmass. -->
  <tank type="FUEL" name="rato_propellant">
    <location unit="M">
      <x>-0.60</x>
      <y>0.0</y>
      <z>-0.10</z>
    </location>
    <capacity unit="KG">9.18</capacity>
    <contents unit="KG">9.18</contents>
    <priority>2</priority>
  </tank>

  <!-- Dry booster ballast/ejection mass. This tank is not referenced by any engine feed. -->
  <tank type="FUEL" name="rato_dry_booster_ballast">
    <location unit="M">
      <x>-0.60</x>
      <y>0.0</y>
      <z>-0.10</z>
    </location>
    <capacity unit="LBS">22.046226</capacity>
    <contents unit="LBS">22.046226</contents>
    <priority>99</priority>
  </tank>

  <!-- Left turbojet engine. -->
  <engine file="SR75_Turbojet">
    <feed>0</feed>
    <thruster file="direct">
      <location unit="M">
        <x>-0.55</x>
        <y>-0.18</y>
        <z>0.0</z>
      </location>
      <orient unit="DEG">
        <pitch>0.0</pitch>
        <yaw>0.0</yaw>
        <roll>0.0</roll>
      </orient>
    </thruster>
  </engine>

  <!-- Right turbojet engine. -->
  <engine file="SR75_Turbojet">
    <feed>0</feed>
    <thruster file="direct">
      <location unit="M">
        <x>-0.55</x>
        <y>0.18</y>
        <z>0.0</z>
      </location>
      <orient unit="DEG">
        <pitch>0.0</pitch>
        <yaw>0.0</yaw>
        <roll>0.0</roll>
      </orient>
    </thruster>
  </engine>

  <!-- Centerline RATO booster engine. Engine index 2 is commanded by the RATO script. -->
  <engine file="SR75_RATO">
    <feed>1</feed>
    <thruster file="direct">
      <location unit="M">
        <x>-0.80</x>
        <y>0.0</y>
        <z>-0.10</z>
      </location>
      <orient unit="DEG">
        <pitch>0.0</pitch>
        <yaw>0.0</yaw>
        <roll>0.0</roll>
      </orient>
    </thruster>
  </engine>

</propulsion>
