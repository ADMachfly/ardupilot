<?xml version="1.0" encoding="utf-8"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="SR75 Layer 2J-B3C-B2 turbojet propulsion sanity test">

  <description>
    JSBSim-only propulsion sanity test. Both turbojets running, RATO off,
    controls neutral. fcs/turbojet-throttle-cmd-norm is set via
    --property= on the command line so one script covers every throttle
    level; this event only arms the engines and zeroes RATO/controls.
  </description>

  <use aircraft="sr_75_6_dof" initialize="layer2j_b3_trim_init"/>

  <run start="0.0" end="20.0" dt="0.008333">
    <event name="Arm turbojets, RATO off, controls neutral">
      <condition>simulation/sim-time-sec ge 0.0</condition>
      <set name="propulsion/engine[0]/set-running" value="1"/>
      <set name="propulsion/engine[1]/set-running" value="1"/>
      <set name="propulsion/engine[2]/set-running" value="0"/>
      <set name="fcs/rato-throttle-cmd-norm" value="0.0"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>
  </run>

  <output name="sr75_b3c_b2_propulsion_sanity.csv" type="CSV" rate="50">
    <property>simulation/sim-time-sec</property>
    <property>fcs/turbojet-throttle-cmd-norm</property>
    <property>fcs/sr75-fadec-throttle-pos-norm</property>
    <property>fcs/throttle-cmd-norm[0]</property>
    <property>fcs/throttle-cmd-norm[1]</property>
    <property>fcs/throttle-cmd-norm[2]</property>
    <property>propulsion/engine[0]/set-running</property>
    <property>propulsion/engine[1]/set-running</property>
    <property>propulsion/engine[0]/n1</property>
    <property>propulsion/engine[0]/n2</property>
    <property>propulsion/engine[1]/n1</property>
    <property>propulsion/engine[1]/n2</property>
    <property>propulsion/engine[0]/thrust-lbs</property>
    <property>propulsion/engine[1]/thrust-lbs</property>
    <property>propulsion/engine[2]/thrust-lbs</property>
    <property>propulsion/engine[0]/fuel-flow-rate-pps</property>
    <property>propulsion/engine[1]/fuel-flow-rate-pps</property>
    <property>accelerations/a-pilot-x-ft_sec2</property>
    <property>velocities/vt-fps</property>
    <property>velocities/mach</property>
    <property>atmosphere/density-altitude</property>
    <property>position/h-sl-ft</property>
    <property>velocities/h-dot-fps</property>
  </output>

</runscript>
