<?xml version="1.0" encoding="utf-8"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="SR75 HIL-F24-R3A Mission Planner dynamic visualization trajectory">

  <description>
    HIL-F24-R3A: deterministic read-only visualization trajectory for
    Mission Planner over PPP/SIM_JSON. JSBSim is used as the time source
    and CSV publisher, but the output state is a scripted bounded
    trajectory: no Pixhawk command is fed back to JSBSim, and engine,
    throttle, RATO, ejection and flight-control command properties are
    pinned at zero for the entire run.

    Expected moving display envelope after the R3G EKF-ready handoff:
      north/east displacement: about 180 m / 120 m
      altitude change: +30 m
      roll: 0..+4 deg
      pitch: 0..+3 deg
      yaw change: +15 deg
  </description>

  <use aircraft="sr_75_6_dof" initialize="hil_f24r3a_visual_time_source_init"/>

  <run start="0.0" end="3600.0" dt="0.02">
    <event name="Safety pins: engines/RATO/throttle/controls remain zero">
      <condition>simulation/sim-time-sec ge 0.0</condition>
      <set name="propulsion/engine[0]/set-running" value="0"/>
      <set name="propulsion/engine[1]/set-running" value="0"/>
      <set name="propulsion/engine[2]/set-running" value="0"/>
      <set name="fcs/turbojet-throttle-cmd-norm" value="0.0"/>
      <set name="fcs/rato-throttle-cmd-norm" value="0.0"/>
      <set name="fcs/throttle-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/elevator-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>
  </run>
  <output name="../../../../../tmp/sr75_hil_f24r3a_mp_visual_raw.csv" type="CSV" rate="50">
    <!-- u = clamp(t / 60, 0, 1); s = 3u^2 - 2u^3. R3G keeps the
         Pixhawk on a separate stationary truth feeder until EKF readiness;
         this moving feeder starts only after that gate succeeds. -->
