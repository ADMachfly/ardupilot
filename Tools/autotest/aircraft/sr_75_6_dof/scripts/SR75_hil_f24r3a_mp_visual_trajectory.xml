      <property>simulation/sim-time-sec</property>
    </function>
    <function name="lat_deg">
      <sum><value>32.5378085</value><product><value>0.00161694</value><product><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min><difference><value>3.0</value><product><value>2.0</value><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min></product></difference></product></product></sum>
    </function>
    <function name="lon_deg">
      <sum><value>74.3661944</value><product><value>0.00126792</value><product><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min><difference><value>3.0</value><product><value>2.0</value><min><value>1.0</value><max><value>0.0</value><product><property>simulation/sim-time-sec</property><value>0.0166666666667</value></product></max></min></product></difference></product></product></sum>
