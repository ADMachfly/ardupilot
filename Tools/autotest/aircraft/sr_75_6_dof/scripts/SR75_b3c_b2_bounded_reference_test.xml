<?xml version="1.0" encoding="utf-8"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="SR75 Layer 2J-B3C-B2 bounded longitudinal reference candidate test">

  <description>
    JSBSim-only bounded-reference candidate test. Both turbojets running,
    RATO off, aileron/rudder held at zero. Initial alpha/theta, elevator, and
    turbojet throttle are all set via --property= on the command line so one
    script covers the whole search grid without relying on JSBSim's own
    (fragile, aborts-on-failure) trim solver.
  </description>

  <use aircraft="sr_75_6_dof" initialize="layer2j_b3_trim_init"/>

  <run start="0.0" end="5.0" dt="0.008333">
    <event name="Arm turbojets, RATO/aileron/rudder off">
      <condition>simulation/sim-time-sec ge 0.0</condition>
      <set name="propulsion/engine[0]/set-running" value="1"/>
      <set name="propulsion/engine[1]/set-running" value="1"/>
      <set name="propulsion/engine[2]/set-running" value="0"/>
      <set name="fcs/rato-throttle-cmd-norm" value="0.0"/>
      <set name="fcs/aileron-cmd-norm" value="0.0"/>
      <set name="fcs/rudder-cmd-norm" value="0.0"/>
      <notify/>
    </event>
  </run>

  <output name="sr75_b3c_b2_bounded_reference.csv" type="CSV" rate="50">
    <property>simulation/sim-time-sec</property>
    <property>attitude/phi-deg</property>
    <property>attitude/theta-deg</property>
    <property>aero/alpha-deg</property>
    <property>fcs/elevator-cmd-norm</property>
    <property>fcs/turbojet-throttle-cmd-norm</property>
    <property>propulsion/engine[0]/thrust-lbs</property>
    <property>propulsion/engine[1]/thrust-lbs</property>
    <property>propulsion/engine[2]/thrust-lbs</property>
    <property>velocities/vt-fps</property>
    <property>velocities/p-rad_sec</property>
    <property>velocities/q-rad_sec</property>
    <property>velocities/r-rad_sec</property>
    <property>velocities/h-dot-fps</property>
    <property>position/h-sl-ft</property>
  </output>

</runscript>
