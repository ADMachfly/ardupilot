<?xml version="1.0" encoding="utf-8"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="SR75 rudder sign diagnostic">

  <use aircraft="sr_75_6_dof" initialize="cruise_init"/>

  <run start="0.0" end="5.0" dt="0.008333">
    <event name="Apply positive rudder">
      <condition>simulation/sim-time-sec ge 0.0</condition>
      <set name="propulsion/engine[0]/set-running" value="1"/>
      <set name="propulsion/engine[1]/set-running" value="1"/>
      <set name="fcs/turbojet-throttle-cmd-norm" value="0.45"/>
      <set name="fcs/rudder-cmd-norm" value="0.3"/>
      <notify/>
    </event>
  </run>

  <output name="SR75_test_rudder.csv" type="CSV" rate="50">
    <property>simulation/sim-time-sec</property>
    <property>fcs/rudder-cmd-norm</property>
    <property>attitude/psi-deg</property>
    <property>velocities/r-rad_sec</property>
  </output>

</runscript>
