# SR-75 Jet Powered UAV - SITL Parameters
# Weight: 82.5 kg | Thrust: 800N
# Cruise: 69 m/s | Max: 125 m/s (200 m/s during RATO)
# Stall: 34 m/s | Climb: 27 m/s

# RATO Booster Parameters
RATO_ENABLE 1
RATO_THR_N 5800
RATO_MASS_KG 10
RATO_BURN_S 3.0
RATO_PITCH 20
RATO_REL_ALT 160
RATO_REL_DIST 600
RATO_REL_SPD 180
RATO_MAX_G 7.0
RATO_MIN_G 2.0
RATO_TIMEOUT 8.0
RATO_IGN_CH 0
RATO_EJECT_CH 0

# Airspeed - raised from 125 to 200 to cover RATO boost speed
AIRSPEED_MAX 200
AIRSPEED_MIN 40
AIRSPEED_CRUISE 69
ARSPD_FBW_MAX 200
ARSPD_FBW_MIN 40
TRIM_ARSPD_CM 6900

THR_MAX 100
THR_MIN 0
THR_CRUISE 55

TECS_CLMB_MAX 27
TECS_SINK_MIN 6
TECS_SINK_MAX 30
TECS_TIME_CONST 5.0
TECS_THR_DAMP 0.8
TECS_PTCH_DAMP 0.5
TECS_INTEG_GAIN 0.3
TECS_SPDWEIGHT 1.0
TECS_RLL2THR 15.0
TECS_PITCH_MAX 30
TECS_PITCH_MIN -8

PTCH_LIM_MAX_DEG 30
PTCH_LIM_MIN_DEG -30

NAVL1_PERIOD 25
NAVL1_DAMPING 0.75
WP_RADIUS 120
WP_LOITER_RAD 200

# Changed TKOFF_PITCH_CD from 1500 to 2000 for steeper RATO climb
TKOFF_PITCH_CD 2000
TKOFF_ROTATE_SPD 40
TKOFF_LVL_ALT 300
TKOFF_THR_MAX_T 4

SCALING_SPEED 69
STALL_PREVENTION 1
LOG_BITMASK 65535

# Fixed - was merged with LOG_BITMASK in your original file
SIM_ENGINE_MUL 25